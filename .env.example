# 로컬 개발용 환경변수 예시. 복사해서 쓴다: cp .env.example .env
# .env는 git에 올리지 않는다. 아래 값은 예시이므로 반드시 바꾼다.

# PostgreSQL (비밀번호는 URL에 들어가므로 영문·숫자만 사용)
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me-to-random-alnum
POSTGRES_DB=travel_copilot
# 내 컴퓨터에서 DB에 접속할 포트 (다른 프로젝트의 5432와 겹치지 않게)
POSTGRES_HOST_PORT=55432

# 서버 로그 레벨
LOG_LEVEL=INFO

# 서버 테스트(pytest)용. 쓸 때는 셸에서 export 한다 (README '서버 테스트' 참고)
# TEST_DATABASE_URL=postgresql+asyncpg://travel:<POSTGRES_PASSWORD>@localhost:55432/travel_copilot_test
