# 로컬 개발용 환경변수 예시. 복사해서 쓴다: cp .env.example .env
# .env는 git에 올리지 않는다. 아래 값은 예시이므로 반드시 바꾼다.

# PostgreSQL (비밀번호는 URL에 들어가므로 영문·숫자만 사용)
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me-to-random-alnum
POSTGRES_DB=travel_copilot
# 내 컴퓨터에서 DB에 접속할 포트 (다른 프로젝트의 5432와 겹치지 않게)
POSTGRES_HOST_PORT=55432

# 서버 로그 레벨
LOG_LEVEL=INFO

# 서버 테스트(pytest)용. 쓸 때는 셸에서 export 한다 (README '서버 테스트' 참고)
# TEST_DATABASE_URL=postgresql+asyncpg://travel:<POSTGRES_PASSWORD>@localhost:55432/travel_copilot_test

# 자체 액세스 토큰 서명 키 (32자 이상 무작위). 생성: openssl rand -base64 48
JWT_SECRET=change-me-to-random-string-at-least-32-characters

# Google 로그인 (공개값). 웹 클라이언트 ID = ID 토큰의 aud
GOOGLE_WEB_CLIENT_ID=123992552687-uef3jdm8amhgf9281upv227p3a5mqa5k.apps.googleusercontent.com
# 쉼표로 구분한 앱 클라이언트 ID (iOS, Android). ID 토큰의 azp 검사에 사용
GOOGLE_ALLOWED_AZP=123992552687-7afke23oe10usl9rj2ckdoupa7p826b9.apps.googleusercontent.com,123992552687-iall7akrng57h8vf3unhmv84nosol6k2.apps.googleusercontent.com
